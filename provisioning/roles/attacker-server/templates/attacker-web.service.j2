[Unit]
Description=SEED attacker web server (DNS rebinding lab)
After=network-online.target
Wants=network-online.target

[Service]
User={{ attacker_user }}
Group={{ attacker_user }}
WorkingDirectory={{ attacker_dir }}
Environment=FLASK_APP=rebind_malware
Environment=FLASK_RUN_HOST=0.0.0.0
Environment=FLASK_RUN_PORT={{ attacker_web_port }}
ExecStart={{ seed_venv_python }} -m flask run
Restart=on-failure
RestartSec=2

[Install]
WantedBy=multi-user.target
